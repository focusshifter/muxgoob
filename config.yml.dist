telegram_key: no_key
reply_tech_link: url
nametrigger:
  triggers:
    - usernames: []
      chance:
      reply:
# IANA timezone used for birthdays and cron schedules (for example Europe/Moscow).
time_zone: Europe/Moscow
# birthdays are stored in SQLite now. If this legacy section is present,
# it is imported/upserted into the birthdays table on startup.
# birthdays:
#   - chat_id: 123456789
#     users:
#       username1: 2006-01-02
dupe_ignored_domains:
  - twitch.tv
  - www.twitch.tv
twitch_api_key: no_key
twitch_streams:
  - chat_id: 123456789
    twitch_usernames:
      - username1
      - username2
# Default dispatch: OpenAI GPT -> Codex OAuth; non-OpenAI models -> OrcaRouter.
# Explicit openrouter:<model> overrides only that workload; ai_provider: openrouter
# preserves intentional OpenRouter-only chats. Native slash IDs are opaque.
ai_provider: openai-codex
ai_model: openai/gpt-5.4
# Image provider: openai-codex (Codex OAuth), openrouter, or orcarouter.
image_ai_provider: openai-codex
image_ai_model: gpt-image-2
# Vision/chat-completions model for recognizing incoming images; separate from the image generator.
image_vision_model: google/gemini-3.1-flash-lite-preview
# Optional pixel size (for example 2048x2048); leave empty for a model-aware default.
image_ai_size:
# Optional Codex/OpenRouter/OrcaRouter/AllModels text/tool model for composing image prompts before generation.
# Modes: off (default), direct (always use the composer), fallback (retry only when no image was sent).
image_prompt_provider: openai-codex
image_prompt_model:
image_prompt_mode: off
openai_api_key: no_key
openrouter_api_key: no_key
# OrcaRouter key for non-OpenAI models under the default Codex dispatcher.
# Adding a key does not write provider/model settings. Explicit orcarouter:<model>
# or ai_provider: orcarouter also selects Orca, even for OpenAI models.
# Uses https://api.orcarouter.ai/v1 with its OWN Bearer key; no credential fallback.
# Model IDs pass through unchanged, including orcarouter/auto and orcarouter/free.
# Also supported for vision, selfprompt, image-prompt composition, Spotify writers/judge,
# and dedicated image generation via the image provider or per-model routing prefix.
# Spotify Sonar published-research/citations intentionally still require OpenRouter:
# research.go relies on OpenRouter's citation envelope; it is NOT silently rerouted.
orcarouter_api_key:
# Optional explicit-only AllModels text/tools/vision route; never selected by default.
# Use ai_provider: allmodels OR a single-model prefix allmodels:<opaque/model>.
# Example private reply ID: allmodels:deepseek/deepseek-v4.1-flash-abliterated
# Own Bearer key, https://api.allmodels.io/oai; no credential/provider fallback.
# Every AllModels request requires provider.zdr=true, including capacity failovers.
# No AllModels image generation. Prompt composition remains a text/tool workload.
# Optional terminal :online uses AllModels hosted search only; see docs/allmodels.md
# for the live verification gate and limits. No settings change merely by adding a key.
allmodels_api_key:
chat_gpt_use_history: true
chat_gpt_history_depth: 20
chat_gpt_system_prompt:
chat_gpt_config_per_chat:
  - chat_id: -1
    system_prompt: "Custom chat prompt"
chat_gpt_user_prompt:
owner_username: your_username

# Self-updating prompt plugin configuration
selfprompt:
  enabled: true  # Enable/disable the plugin globally
  message_interval: 100  # Update prompt after this many messages
  disabled_chats:  # List of chat IDs where the plugin should not run
    - 123456789

# Spotify plugin configuration
# Get credentials from https://developer.spotify.com/dashboard/applications
spotify:
  client_id:      # Your Spotify app client ID
  client_secret:  # Your Spotify app client secret

# Gooby the Music Critic
# https://api.telegra.ph/createAccount?short_name=foo&author_name=bar
spotify_review_prompt: |
    Supports templating! See plugins/spotify/review.go
    Write a witty review in RUSSIAN about the {type} "{title}" ({year}) by {artist}.
    Semi-follow the overall consensus from the facts below instead of being automatically harsh.
    Mention both what works and what does not, using concrete musical observations.
    If the type is album, choose any numeric rating and return it in the structured album_rating field; 0–10 is a guide, not a hard range, and fractional values are allowed.
    No Markdown, plain text only.

    {grounding}
spotify_review_microblog_auth:
# Opt in ONLY by configuring candidates; empty/missing keeps the legacy single-model route.
# Example candidates: [anthropic/claude-opus-5.5, openai/gpt-6.1-sol]
# With ai_provider: openai-codex, GPT writers/judge use Codex, non-OpenAI IDs use
# OrcaRouter. Explicit openrouter:<model> retains OpenRouter for that author/judge.
# Published Sonar research always uses OpenRouter independently.
spotify_review_candidate_models: []
# Default when ensemble is enabled: openai/gpt-6.1-sol.
spotify_review_judge_model:
# Per-candidate and judge deadline; 0/missing means 300 seconds.
spotify_review_timeout_seconds: 300
# Optional durable JSONL audit directory. Always logs structured audit before publication.
# When configured, an append failure blocks publication. Protect logs: they contain review drafts.
spotify_review_audit_dir:

telegram_key: no_key
reply_tech_link: url
nametrigger:
  triggers:
    - usernames: []
      chance:
      reply:
# IANA timezone used for birthdays and cron schedules (for example Europe/Moscow).
time_zone: Europe/Moscow
# birthdays are stored in SQLite now. If this legacy section is present,
# it is imported/upserted into the birthdays table on startup.
# birthdays:
#   - chat_id: 123456789
#     users:
#       username1: 2006-01-02
dupe_ignored_domains:
  - twitch.tv
  - www.twitch.tv
twitch_api_key: no_key
twitch_streams:
  - chat_id: 123456789
    twitch_usernames:
      - username1
      - username2
ai_provider: openrouter
ai_model: deepseek/deepseek-chat
# Image provider: openai-codex (Codex OAuth) or openrouter (OpenRouter Image API).
image_ai_provider: openai-codex
image_ai_model: gpt-image-2
# Optional OpenRouter text model for composing direct image prompts before generation.
# Modes: off (default), direct (always use the composer), fallback (retry only when no image was sent).
image_prompt_provider: openrouter
image_prompt_model:
image_prompt_mode: off
openai_api_key: no_key
openrouter_api_key: no_key
chat_gpt_use_history: true
chat_gpt_history_depth: 20
chat_gpt_system_prompt:
chat_gpt_config_per_chat:
  - chat_id: -1
    system_prompt: "Custom chat prompt"
chat_gpt_user_prompt:
owner_username: your_username

# Self-updating prompt plugin configuration
selfprompt:
  enabled: true  # Enable/disable the plugin globally
  message_interval: 100  # Update prompt after this many messages
  disabled_chats:  # List of chat IDs where the plugin should not run
    - 123456789

# Spotify plugin configuration
# Get credentials from https://developer.spotify.com/dashboard/applications
spotify:
  client_id:      # Your Spotify app client ID
  client_secret:  # Your Spotify app client secret

# Gooby the Music Critic
# https://api.telegra.ph/createAccount?short_name=foo&author_name=bar
spotify_review_prompt: |
    Supports templating! See plugins/spotify/review.go
    Write a witty review in RUSSIAN about the {type} "{title}" ({year}) by {artist}.
    Semi-follow the overall consensus from the facts below instead of being automatically harsh.
    Mention both what works and what does not, using concrete musical observations.
    If the type is album, give the album a numeric rating from 1 to 10 in 0.5 increments; return it in the structured album_rating field and do not include the rating in review_text.
    No Markdown, plain text only.

    {grounding}
spotify_review_microblog_auth:

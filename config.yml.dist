telegram_key: no_key
reply_tech_link: url
nametrigger:
  triggers:
    - usernames: []
      chance:
      reply: 
time_zone: Europe/Moscow
birthdays:
  - chat_id: 123456789
    users:
      username1: 2006-01-02
dupe_ignored_domains:
  - twitch.tv
  - www.twitch.tv
twitch_api_key: no_key
twitch_streams:
  - chat_id: 123456789
    twitch_usernames:
      - username1 
      - username2
ai_provider: openrouter
ai_model: deepseek/deepseek-chat
openai_api_key: no_key
openrouter_api_key: no_key
chat_gpt_use_history: true
chat_gpt_history_depth: 20
chat_gpt_system_prompt:
chat_gpt_config_per_chat:
  - chat_id: -1
    system_prompt: "Custom chat prompt"
chat_gpt_user_prompt: 
owner_username: your_username

# Self-updating prompt plugin configuration
selfprompt:
  enabled: true  # Enable/disable the plugin globally
  message_interval: 100  # Update prompt after this many messages
  disabled_chats:  # List of chat IDs where the plugin should not run
    - 123456789

# Spotify plugin configuration
# Get credentials from https://developer.spotify.com/dashboard/applications
spotify:
  client_id:      # Your Spotify app client ID
  client_secret:  # Your Spotify app client secret
